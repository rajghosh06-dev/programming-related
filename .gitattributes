# --- Core source files ---
*.c     text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.java  text eol=lf
*.sql   text eol=lf

# --- Scripts ---
*.sh    text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# --- Config / metadata ---
*.xml   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ini   text eol=lf

# --- Documentation ---
*.md    text eol=lf
*.txt   text eol=lf

# --- Special cases ---
# Keep binary files untouched
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.zip   binary
*.exe   binary
*.dll   binary
