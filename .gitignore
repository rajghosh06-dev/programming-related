# --- General OS/Editor junk ---
*.log
*.tmp
*.swp
*.bak
*.DS_Store
Thumbs.db

# --- Java / Web ---
*.class
*.jar
*.war
*.ear
out/
target/
WEB-INF/classes/
WEB-INF/lib/

# --- IDEs ---
.idea/
*.iml
.vscode/

# --- C / C++ ---
*.o
*.obj
*.exe
*.dll
*.so
*.out

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

# --- Assembly ---
*.lst
*.backup*
*.bak~

# --- Web (HTML, CSS, JS, XML, DTD) ---
# Keep source files, ignore generated/minified or cache
*.min.js
*.min.css
node_modules/
.env

# --- Tooling / automation ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
tools/**/__pycache__/
tools/reports/*.tmp
tools/reports/*.bak
tools/reports/*.old

# --- Databases ---
*.db
*.sqlite
