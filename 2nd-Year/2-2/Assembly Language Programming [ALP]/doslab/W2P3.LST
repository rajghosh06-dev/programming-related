				; PROGRAM TO FIND MAXIMUM OF THREE NUMBERS 
				ASSUME CS:CODE, DS:DATA 
 0000				DATA SEGMENT 
 0000  13 56 67 08 A5		        ARR DB 13H, 56H, 67H, 08H, 0A5H 
 0005				DATA ENDS 
 0000				CODE SEGMENT 
 0000  B8 ---- R		        MOV AX, DATA 
 0003  8E D8			        MOV DS, AX 
 0005  BE 0000 R		        MOV SI, OFFSET ARR      ;USING DIRECTIV
				E 
				                                ;ALTERNATIVE US
				ING : LEA SI, ARR 
 0008  B1 04			        MOV CL, 04H             ;NO. OF COMPARI
				SION(N-1): N: NUMBER OF ELEMENTS 
 000A  8A 04			        MOV AL, [SI]            ;LOADING THE FI
				RST ELEMENT OF [SI] 
 000C  46			        INC SI                  ;INCREMENTING T
				HE SI TO NEXT ELEMENT 
				 
 000D  8A 1C			        BACK: MOV BL,[SI]       ;MOVING THE ELE
				MENT OF [SI] INTO BL 
 000F  3A C3			        CMP AL, BL              ;COMPARING AL A
				ND BL ELEMENTS 
				 
 0011  77 02			        JA GO                   ;JA-> JUMP IF A
				BOVE USED FOR UNUSED FOR UNSIGNED NUMBERS 
				                                ;JG-> JUMP IF G
				REATER USED FOR SIGNED NUMBERS 
 0013  86 C3			        XCHG AL, BL             ;IF AL<BL EXCHA
				NGE THE CONTENT SUCH THAT AL IS ALWAYS BIGGER N
				UMBER 
 0015  46			        GO: INC SI              ;INCREMENT THE 
				POSITION TO THE NEXT ELEMENT 
 0016  FE C9			        DEC CL                  ;DECREMENT COUN
				TER 
 0018  75 F3			        JNZ BACK                ;IF CL!=0 REPEA
				T INTO MEMORY 
 001A  88 04			        MOV [SI],AL             ;STORING THE RE
				SULT INTO MEMORY 
 001C  CC			        INT 03H                 ;SIGNIFIES BREA
				KPOINT, HALTING PROBLEM EXECUTION AND TRANSFER 
				                                ;CONTROL TO THE
				 DEBUGGER 
 001D				CODE ENDS 
				END 
