				; PROGRAM TO PRINT NUMBERS FROM 0 TO 9 
				ASSUME CS:CODE, DS:DATA 
 0000				DATA SEGMENT 
 0000  0A			        COU DB 0AH 
 0001  0010[			        ARRNUM DB 10H DUP(0) 
	   00			
			 ]	
				
 0011				DATA ENDS 
 0000				CODE SEGMENT 
 0000  B8 ---- R		        MOV AX, DATA 
 0003  8E D8			        MOV DS, AX 
 0005  8A 0E 0000 R		        MOV CL, COU 
 0009  BE 0001 R		        MOV SI, OFFSET ARRNUM 
 000C  B0 00			        MOV AL, 00H 
				 
 000E  88 04			  BACK: MOV [SI], AL 
 0010  FE C9			        DEC CL 
 0012  74 05			        JZ GO 
 0014  FE C0			        INC AL 
 0016  46			        INC SI 
 0017  EB F5			        JMP BACK 
				 
 0019  F4			    GO: HLT 
 001A				CODE ENDS 
				END 
