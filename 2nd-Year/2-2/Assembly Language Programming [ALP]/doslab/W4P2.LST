				; PROGRAM TO PRINT FIBONACCI SERIES UPTO 5 NUMB
				ERS 
				ASSUME CS:CODE, DS:DATA 
 0000				DATA SEGMENT 
 0000  45 4E 54 45 52 20 54	        NUM1 DB "ENTER THE NUMBER:$" 
       48 45 20 4E 55 4D 42	
       45 52 3A 24		
 0012  ??			        TEMP DB ? 
 0013  000A[			        FIBARR DB 10 DUP(0) 
	   00			
			 ]	
				
 001D				DATA ENDS 
 0000				CODE SEGMENT 
 0000  B8 ---- R		        MOV AX, DATA 
 0003  8E D8			        MOV DS, AX 
				 
 0005  BE 0013 R		        MOV SI, OFFSET FIBARR 
 0008  8D 16 0000 R		        LEA DX, NUM1 
 000C  B4 09			        MOV AH, 09H     ;DISPLAY OF THE STRING 
 000E  CD 21			        INT 21H 
				 
 0010  2C 30			        SUB AL, 30H     ;INPUT IS IN ASCII CODE
				, TO CONVERT INTO DECIMAL NUMBER 
				                        ;ASCII CODE FOR DECIMAL
				 NUKMBERS: 30H TO 39H 
 0012  8A C8			        MOV CL, AL      ;INITIALIZING THE CL(CO
				UNT) REGISTER WITH THE GIVEN NUMBER 
				 
 0014  B0 00			        MOV AL, 00      ;FIRST NUMBER OF FIBONA
				CCI SERIES LOADED INTO AL 
 0016  88 04			        MOV [SI],AL     ;MOVING INTO THE MEMORY
				 
 0018  04 30			        ADD AL, 30H     ;CONVERTING THE NUMBER 
				TO ASCII CODE 
 001A  8A D0			        MOV DL, AL      ;...? 
 001C  B4 02			        MOV AH, 02H     ;TO DISPLAY THE NUMBER 
				IN DEBUG MODE 
 001E  CD 21			        INT 21H 
				 
 0020  B0 01			        MOV AL, 01H     ;INCREMENTING THE AL TO
				 GET THE 2ND NUMBER OF FIBONACCI SERIES 
				 
 0022  88 44 01			        MOV [SI+1],AL 
				 
 0025  04 30			        ADD AL,30H      ;CONVERTING THE NUMBER 
				TO ASCII CODE 
 0027  8A D0			        MOV DL, AL      ;...? 
 0029  B4 02			        MOV AH, 02H     ;TO DISPLAY THE NUMBER 
				IN DEBUG MODE 
 002B  CD 21			        INT 21H 
				 
 002D  8A 04			LBL1:   MOV AL,[SI] 
 002F  02 44 01			        ADD AL, [SI+1] 
Microsoft (R) Macro Assembler Version 5.00                  3/3/26 13:56:50
                                                             Page     1-2


 0032  88 44 02			        MOV [SI+2],AL 
 0035  04 30			        ADD AL, 30H 
 0037  8A D0			        MOV DL, AL 
 0039  B4 02			        MOV AH, 02H 
 003B  CD 21			        INT 21H 
 003D  46			        INC SI 
				 
 003E  E2 ED			        LOOP LBL1 
 0040  B4 4C			        MOV AH, 4CH 
 0042  CD 21			        INT 21H 
 0044				CODE ENDS 
				END 
