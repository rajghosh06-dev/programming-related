## 2.2 Frequency Distribution
## [2.3; Example:1 (a,b,c)]
test = c(79, 70, 85, 64, 41, 69, 66, 28, 89, 47, 88, 72, 21, 81, 75, 72, 55, 35, 56, 80, 68, 52, 49, 35, 20, 30, 23, 48, 90, 24, 58, 65, 29, 50, 67, 37, 42, 36, 86, 63, 78, 84, 60, 22, 57, 61, 32, 27, 73, 31)
test
range(test)
## (a)
breaks = seq(20,100,by=10)
breaks
## (b)
C_I = cut(test,breaks,right=FALSE)
Freq = table(C_I)
cbind(Freq)
Rel_Freq = table(C_I)/length(C_I)
cbind(Rel_Freq)
## 2.3 Cumulative Distribution Functions
Cum_Freq = cumsum(Freq)
cbind(Cum_Freq)
## (c) To Display  Total Freq Distribution table consisting of Absolute Frequency, Relative Frequency and Cumulative Frequency in column Format
cbind(Freq, Rel_Freq, Cum_Freq)
